<?xml version="1.0"?>

<robot name="service_bot">
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="1 1 1"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 1 .3"/>
            </material>
        </visual>
        <!-- <collision/>
        <inertial />-->
    </link>

    <link name="left_wheel_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius=".3" length=".1"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>
       <!-- <collision/>
        <inertial />-->
    </link>

    <link name="right_wheel_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius=".3" length=".1"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>
        <!--<collision/>
        <inertial />-->
    </link>

    <link name="right_support_wheel_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius=".2" length=".1"/>
            </geometry>
            <material name="green">
                <color rgba="0 1 0 1"/>
            </material>
        </visual>
        <!--<collision/>
        <inertial />-->
    </link>

    <link name="left_support_wheel_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius=".2" length=".1"/>
            </geometry>
            <material name="green">
                <color rgba="0 1 0 1"/>
            </material>
        </visual>
        <!--<collision/>
        <inertial />-->
    </link>

    <!--<link name="caster_wheel_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius=".15"/>
            </geometry>
            <material name="green">
                <color rgba="0 1 0 1"/>
            </material> 
        </visual>
        <collision/>
        <inertial />
    </link>-->

    <link name="left_support_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size=".25 .25 1.375"/>
            </geometry>
            <material name="teal">
                <color rgba="0 0.5 .5 1"/>
            </material>
        </visual>
        <!--collision/>3
        <inertial /-->
    </link>

    <link name="right_support_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size=".25 .25 1.375"/>
            </geometry>
            <material name="teal">
                <color rgba="0 .5 .5 1"/>
            </material>
        </visual>
        <!--collision/>
        <inertial /-->
    </link>

    <link name="top_block_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.25 1 0.25"/>
            </geometry>
            <material name="teal">
                <color rgba="0 .5 .5 1"/>
            </material>
        </visual>
        <!--collision/>
        <inertial /-->
    </link> 

    <link name="lidar_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius=".1" length=".1"/>
            </geometry>
            <material name="white">
                 <color rgba="1 1 1 1"/>
            </material>
        </visual>
        <!--collision/>
        <inertial /-->
    </link>

    <link name="camera_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius=".1" length=".1"/>
            </geometry>
            <material name="white">
                 <color rgba="1 1 1 1"/>
            </material>
        </visual>
        <!--collision/>
        <inertial /-->
    </link>

   

    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel_link"/>
        <origin xyz="-0.2 0.55 -0.3" rpy="1.57 0 0"/>
        <axis xyz="0 0 1" />
    </joint>

    <joint name="base_left_support_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="left_support_wheel_link"/>
        <origin xyz="0.3 0.55 -0.4" rpy="1.57 0 0"/>
        <!--axis xyz="0 0 1" /-->
    </joint>

    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel_link"/>
        <origin xyz="-0.2 -0.55 -0.3" rpy="1.57 0 0"/>
        <axis xyz="0 0 1" />
    </joint>

    <joint name="base_right_support_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="right_support_wheel_link"/>
        <origin xyz="0.3 -0.55 -0.4" rpy="1.57 0 0"/>
        <!--axis xyz="0 0 1" /-->
    </joint>

    <joint name="base_top_block_joint" type="fixed">
        <parent link="base_link"/>
        <child link="top_block_link"/>
        <origin xyz="0 0 2" rpy="0 0 0"/>
        <!--axis xyz="0 0 1" /-->
    </joint>

    <joint name="top_block_left_joint" type="fixed">
        <parent link="top_block_link"/>
        <child link="left_support_link"/>
        <origin xyz="0 0.375 -0.8125" rpy="0 0 0"/>
        <!--axis xyz="0 0 1" /-->
    </joint>

    <joint name="top_block_right_joint" type="fixed">
        <parent link="top_block_link"/>
        <child link="right_support_link"/>
        <origin xyz="0 -0.375 -0.8125" rpy="0 0 0"/>
        <!--axis xyz="0 0 1" /-->
    </joint>

    <joint name="top_block_lidar_joint" type="fixed">
        <parent link="top_block_link"/>
        <child link="lidar_link"/>
        <origin xyz="0 0 0.155" rpy="0 0 0"/>
        <!--axis xyz="0 0 1" /-->
    </joint>

    <joint name="top_block_camera_joint" type="fixed">
        <parent link="top_block_link"/>
        <child link="camera_link"/>
        <origin xyz="0 0 -0.155" rpy="0 0 0"/>
        <!--axis xyz="0 0 1" /-->
    </joint>
    
<!-- 1.1875 -->


</robot>